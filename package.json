{
  "name": "instagram-relationship-manager",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nx run-many -t serve -p web api --parallel",
    "prebuild": "npm run format:check",
    "build": "nx run-many -t build -p web api",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:api": "nx run api:test",
    "bootstrap:admin": "esbuild apps/api/src/bootstrap-admin.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/apps/api/bootstrap-admin.cjs && node dist/apps/api/bootstrap-admin.cjs"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nx/js": "21.6.5",
    "@nx/esbuild": "21.6.5",
    "@nx/nest": "21.6.5",
    "@nx/next": "21.6.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/multer": "^2.3.0",
    "@types/react": "19.3.0",
    "@types/yauzl": "^3.4.0",
    "next": "^15.2.4",
    "nx": "21.6.5",
    "prettier": "3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "multer": "^2.4.0",
    "yauzl": "^3.4.0"
  }
}
